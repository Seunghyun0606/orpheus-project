{
  "productName": "Orpheus Review - TASK-034",
  "identifier": "com.vantage.orpheus.review",
  "build": {
    "beforeBuildCommand": "npm run build:review:web",
    "frontendDist": "../.qa/review/web"
  },
  "app": {
    "windows": [
      {
        "label": "qa034",
        "title": "Orpheus Review - TASK-034",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "dataDirectory": "review-v1"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
