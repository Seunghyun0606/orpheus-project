{
  "name": "orpheus-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "tauri dev",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "build:desktop": "npm run typecheck && tauri build --no-bundle",
    "build:review:web": "vite build --config vite.review.config.ts",
    "build:review": "node scripts/build-review-installer.mjs",
    "tools:nsis": "node scripts/acquire-nsis.mjs",
    "benchmark": "node --max-old-space-size=16000 scripts/benchmark.mjs",
    "test:release-harness": "node --test scripts/release-harness.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:replays": "vitest run src/tests/inc-001-replay.test.ts",
    "test:watch": "vitest",
    "validate:scenarios": "node scripts/validate-scenarios.mjs",
    "i18n:catalogs": "node scripts/i18n/content-catalog.mjs",
    "validate:locales": "node scripts/i18n/content-catalog.mjs --check",
    "story": "node scripts/story/story.mjs",
    "story:play": "node scripts/story/story.mjs play",
    "validate:story": "node scripts/story/story.mjs check",
    "godot:export": "node scripts/story/export-godot.mjs",
    "godot:play": "node scripts/story/godot.mjs play",
    "godot:parity": "node scripts/story/godot.mjs parity",
    "godot:editor": "node scripts/story/godot.mjs editor",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate:scenarios && npm run validate:locales && npm run validate:story && node scripts/story/export-godot.mjs --check && npm test && npm run test:release-harness && npm run build:web",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
